# Easy Exam 本地运行环境配置模板
# 复制为 .env.runtime.local 后按本机环境修改。
#
# 推荐优先使用 conda 环境名，而不是写死 python.exe 绝对路径。
# 这样跨机器时通常只需要保证环境名一致。

# 可选值：
# - conda  使用 conda run -n <env> python ...
# - system 直接调用 EXAM_PYTHON_EXE 或 PATH 中的 python
EXAM_PYTHON_MODE=conda

# 当 EXAM_PYTHON_MODE=conda 时使用的环境名
EXAM_CONDA_ENV=exam_scheduler

# 可选：conda 可执行命令或绝对路径
# 如果 conda 已在 PATH 中，保持默认 conda 即可
EXAM_CONDA_EXE=conda

# 可选：直接指定 Python 可执行文件或命令名
# 设置后优先级最高，会覆盖 conda 配置
# EXAM_PYTHON_EXE=python
