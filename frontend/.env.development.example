# Python 环境配置示例
# 复制此文件为 .env.development 并修改为你本地的 Python 路径

# 方式 1: 使用 Conda 环境（推荐）
# Windows: VITE_PYTHON_PATH=D:/Anaconda3/envs/exam_scheduler/python.exe
# macOS/Linux: VITE_PYTHON_PATH=/path/to/anaconda3/envs/exam_scheduler/bin/python

# 方式 2: 使用系统 Python（需要手动安装依赖）
# VITE_PYTHON_PATH=python

VITE_PYTHON_PATH=python
