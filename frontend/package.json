{
  "name": "easy-exam",
  "private": true,
  "version": "3.4.0422",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "chcp 65001 >nul 2>&1 && vite",
    "electron:dev": "chcp 65001 >nul 2>&1 && vite",
    "build": "vue-tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:build": "vue-tsc -p tsconfig.json && vite build && electron-builder"
  },
  "build": {
    "appId": "com.easyexam.app",
    "productName": "Easy Exam",
    "directories": {
      "output": "release_v6"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist/engine",
        "to": "engine"
      }
    ],
    "artifactName": "EasyExam-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^14.1.0",
    "element-plus": "^2.8.4",
    "html2pdf.js": "^0.10.2",
    "lucide-vue-next": "^0.563.0",
    "marked": "^17.0.1",
    "pinia": "^2.2.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.23",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.1.6"
  }
}
